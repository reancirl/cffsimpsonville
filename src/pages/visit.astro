---
import Layout from '../layouts/Layout.astro';
import Visit from '../components/Visit.astro';
import ScrollReveal from '../components/ScrollReveal.tsx';
import { breadcrumb, webPage } from '../config/schema';

const title = 'Visit Us — Hours, Location & Directions | Carolina Fine Foods';
const description =
  'Find Carolina Fine Foods at 625 SE Main St, Simpsonville, SC 29681. Lunch buffet Mon–Fri 11–2:30, breakfast buffet Sat–Sun 7–11. Call 864-967-3335 or get directions.';

const schema = [
  webPage(title, '/visit', description),
  breadcrumb([{ name: 'Visit', path: '/visit' }]),
];
---

<Layout title={title} description={description} path="/visit" schema={schema}>
  <div class="page-top">
    <Visit headingLevel="h1" />
  </div>
  <ScrollReveal client:load />
</Layout>
