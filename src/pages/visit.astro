---
import Layout from '../layouts/Layout.astro';
import Visit from '../components/Visit.astro';
import ScrollReveal from '../components/ScrollReveal.tsx';
import { visitPageSchema } from '../lib/schema/visitPageSchema';

const title = 'Visit Us — Hours, Location & Directions | Carolina Fine Foods';
const description =
  'Find Carolina Fine Foods at 625 SE Main St, Simpsonville, SC 29681. Hot Lunch Bar and Salad Bar Mon–Fri 11 AM–2:25 PM, breakfast buffet Sat–Sun 7 AM–11 AM.';

const schema = visitPageSchema(title, description);
---

<Layout title={title} description={description} path="/visit" schema={schema}>
  <div class="page-top">
    <Visit headingLevel="h1" />
  </div>
  <ScrollReveal client:idle />
</Layout>
