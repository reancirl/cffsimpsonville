---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import ScrollReveal from '../components/ScrollReveal.tsx';
import { breadcrumb, webPage } from '../config/schema';

const title = 'Gallery — Southern Food & Buffet Photos | Carolina Fine Foods';
const description =
  'A look inside Carolina Fine Foods in Simpsonville, SC — our buffet line, handmade Southern plates, fried chicken, mac & cheese and the dishes made fresh every morning.';

const schema = [
  webPage(title, '/gallery', description),
  breadcrumb([{ name: 'Gallery', path: '/gallery' }]),
];
---

<Layout
  title={title}
  description={description}
  path="/gallery"
  image="/images/honest.jpg"
  schema={schema}
>
  <div class="page-top">
    <Gallery variant="full" headingLevel="h1" />
  </div>
  <ScrollReveal client:load />
</Layout>
