---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import ScrollReveal from '../components/ScrollReveal.tsx';
import { galleryImages } from '../data/gallery';
import { galleryPageSchema } from '../lib/schema/galleryPageSchema';

const title = 'Gallery — Southern Food & Buffet Photos | Carolina Fine Foods';
const description =
  'A look inside Carolina Fine Foods in Simpsonville, SC — our buffet line, handmade Southern plates, fried chicken, mac & cheese and the dishes made fresh every morning.';

const schema = galleryPageSchema(title, description, galleryImages);
---

<Layout
  title={title}
  description={description}
  path="/gallery"
  image="/images/honest.jpg"
  schema={schema}
>
  <div class="page-top">
    <Gallery variant="full" headingLevel="h1" />
  </div>
  <ScrollReveal client:idle />
</Layout>
