---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Story from '../components/Story.astro';
import Video from '../components/Video.astro';
import MenuSection from '../components/Menu.astro';
import Gallery from '../components/Gallery.astro';
import PrivateDiningTeaser from '../components/PrivateDiningTeaser.astro';
import Reviews from '../components/Reviews.astro';
import Visit from '../components/Visit.astro';
import ScrollReveal from '../components/ScrollReveal.tsx';
import {
  HOME_DESCRIPTION,
  HOME_TITLE,
  homePageSchema,
} from '../lib/schema/homePageSchema';

const schema = homePageSchema();
---

<Layout title={HOME_TITLE} description={HOME_DESCRIPTION} path="/" schema={schema}>
  <Hero />
  <Marquee />
  <Story headingLevel="h2" />
  <Video />
  <MenuSection variant="teaser" />
  <Gallery variant="teaser" />
  <PrivateDiningTeaser />
  <Reviews variant="teaser" />
  <Visit />
  <ScrollReveal client:idle />
</Layout>
