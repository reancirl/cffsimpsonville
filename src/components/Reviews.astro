---
// Reviews are added manually because pulling live Google reviews isn't free for development.
// To update: edit src/data/reviews.json (review list + the rating / total figures).
import reviewsData from '../data/reviews.json';

interface Props {
  headingLevel?: 'h1' | 'h2';
  /** Show the B93.7 press strip. Off on the homepage, where the film already appears. */
  showPress?: boolean;
}
const { headingLevel = 'h2', showPress = true } = Astro.props;
const Heading = headingLevel;

const { rating, total, reviewUrl } = reviewsData;
// Spotlight the first review as a large pull-quote; the rest fill the grid.
const REVIEWS = reviewsData.reviews;
const featured = REVIEWS[0];
const gridReviews = REVIEWS.slice(1);

// Round the aggregate to nearest half for the header star row.
const fullStars = Math.floor(rating);
const hasHalf = rating - fullStars >= 0.25 && rating - fullStars < 0.75;
const ratingStars = Array.from({ length: 5 }, (_, i) => {
  if (i < fullStars) return 'full';
  if (i === fullStars && hasHalf) return 'half';
  return 'empty';
});

const STAR_PATH = 'M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01z';
---

<section class="reviews section" id="reviews">
  <div class="container">
    <header class="reviews__header" data-reveal>
      <span class="eyebrow">Kind Words</span>
      <Heading data-reveal-heading>Loved by the Upstate.</Heading>

      <div class="reviews__summary">
        <span class="reviews__rating-num">{rating.toFixed(1)}</span>
        <span class="reviews__stars" aria-label={`${rating} out of 5 stars`}>
          <svg width="0" height="0" style="position:absolute" aria-hidden="true">
            <defs>
              <linearGradient id="star-half">
                <stop offset="50%" stop-color="var(--color-gold)" />
                <stop offset="50%" stop-color="rgba(26,20,16,0.18)" />
              </linearGradient>
            </defs>
          </svg>
          {ratingStars.map((s) => (
            <svg viewBox="0 0 24 24" class={`reviews__star reviews__star--${s}`} aria-hidden="true">
              <path d={STAR_PATH} />
            </svg>
          ))}
        </span>
        <span class="reviews__count">{total.toLocaleString()} Google reviews</span>
      </div>
    </header>

    {featured && (
      <figure class="reviews__featured" data-reveal>
        <span class="reviews__featured-mark" aria-hidden="true">&ldquo;</span>
        <blockquote class="reviews__featured-quote">{featured.text}</blockquote>
        <figcaption class="reviews__featured-cite">
          {featured.image
            ? <img class="reviews__featured-avatar" src={featured.image} alt={`${featured.author} profile photo`} width="48" height="48" loading="lazy" />
            : <span class="reviews__featured-avatar reviews__avatar--initial">{featured.author.charAt(0)}</span>}
          <span class="reviews__featured-who">
            <span class="reviews__featured-name">{featured.author}</span>
            <span class="reviews__featured-meta">{featured.meta} · Google</span>
          </span>
          <span class="reviews__featured-stars" aria-label={`${featured.rating} out of 5`}>
            {Array.from({ length: 5 }, (_, i) => (
              <svg viewBox="0 0 24 24" class={`reviews__star ${i < featured.rating ? 'reviews__star--full' : 'reviews__star--empty'}`} aria-hidden="true">
                <path d={STAR_PATH} />
              </svg>
            ))}
          </span>
        </figcaption>
      </figure>
    )}

    <div class="reviews__grid" data-reveal-stagger>
      {gridReviews.map((r) => (
        <figure class="reviews__card">
          <div class="reviews__card-head">
            {r.image
              ? <img class="reviews__avatar" src={r.image} alt={`${r.author} profile photo`} width="44" height="44" loading="lazy" />
              : <span class="reviews__avatar reviews__avatar--initial">{r.author.charAt(0)}</span>}
            <figcaption class="reviews__author-meta">
              <span class="reviews__author-name">{r.author}</span>
              <span class="reviews__author-sub">{r.meta}</span>
            </figcaption>
            <svg class="reviews__google" viewBox="0 0 48 48" width="22" height="22" aria-label="Posted on Google">
              <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
              <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
              <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
              <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
            </svg>
          </div>
          <div class="reviews__rating-row">
            <span class="reviews__card-stars" aria-label={`${r.rating} out of 5`}>
              {Array.from({ length: 5 }, (_, i) => (
                <svg viewBox="0 0 24 24" class={`reviews__star ${i < r.rating ? 'reviews__star--full' : 'reviews__star--empty'}`} aria-hidden="true">
                  <path d={STAR_PATH} />
                </svg>
              ))}
            </span>
            <span class="reviews__author-time">{r.time}</span>
          </div>
          <blockquote class="reviews__text">{r.text}</blockquote>
        </figure>
      ))}
    </div>

    {showPress && (
      <aside class="reviews__press" data-reveal>
        <img
          class="reviews__press-img"
          src="/images/mac-n-cheese.webp"
          alt="Carolina Fine Foods' famous mac and cheese"
          width="120"
          height="120"
          loading="lazy"
        />
        <div class="reviews__press-body">
          <span class="eyebrow">As Featured On B93.7</span>
          <p class="reviews__press-text">
            When B93.7&rsquo;s <strong>Big Dave</strong> stopped by, he went straight for the <em>famous mac &amp; cheese</em>.
          </p>
          <a href="/#film" class="reviews__press-link">
            Watch the segment
            <span class="reviews__press-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    )}

    <div class="reviews__cta" data-reveal>
      <a href={reviewUrl} target="_blank" rel="noopener" class="btn btn-primary">
        Write a review
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .reviews {
    background: var(--color-cream);
  }

  .reviews__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 4rem;
  }

  .reviews__header .eyebrow { margin-bottom: 1rem; }
  .reviews__header h2 { margin-bottom: 1.75rem; }

  .reviews__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .reviews__rating-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.8rem;
    color: var(--color-maroon);
    font-weight: 500;
  }

  .reviews__stars {
    display: inline-flex;
    gap: 2px;
  }

  .reviews__star {
    width: 22px;
    height: 22px;
  }

  .reviews__star--full { color: var(--color-gold); fill: currentColor; }
  .reviews__star--empty { color: rgba(26, 20, 16, 0.18); fill: currentColor; }
  .reviews__star--half { fill: url(#star-half); }

  .reviews__count {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
  }

  /* Featured pull-quote — one standout review, enlarged above the grid. */
  .reviews__featured {
    max-width: 860px;
    margin: 0 auto 4rem;
    text-align: center;
    padding: 0 1rem;
  }

  .reviews__featured-mark {
    display: block;
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 0.5;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .reviews__featured-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.4;
    color: var(--color-ink);
    margin: 0 0 2rem;
  }

  .reviews__featured-cite {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }

  .reviews__featured-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .reviews__featured-who {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.25;
  }

  .reviews__featured-name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .reviews__featured-meta {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    margin-top: 1px;
  }

  .reviews__featured-stars {
    display: inline-flex;
    gap: 1px;
    padding-left: 0.85rem;
    border-left: 1px solid rgba(26, 20, 16, 0.15);
  }

  .reviews__featured-stars .reviews__star { width: 16px; height: 16px; }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 3.5rem;
  }

  .reviews__card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--color-bone);
    border: 1px solid rgba(185, 145, 78, 0.2);
    border-radius: 8px;
    padding: 1.5rem 1.5rem 1.75rem;
    box-shadow: 0 30px 60px -45px rgba(26, 20, 16, 0.4);
    transition: transform 0.5s var(--easing), box-shadow 0.5s var(--easing);
  }

  .reviews__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 45px 75px -45px rgba(26, 20, 16, 0.5);
  }

  .reviews__card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .reviews__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    flex-shrink: 0;
    object-fit: cover;
  }

  .reviews__avatar--initial {
    display: grid;
    place-items: center;
    background: var(--color-maroon);
    color: var(--color-bone);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .reviews__author-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    margin-right: auto;
    min-width: 0;
  }

  .reviews__author-name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .reviews__author-sub {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    margin-top: 1px;
  }

  .reviews__google {
    flex-shrink: 0;
    align-self: flex-start;
  }

  .reviews__rating-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .reviews__card-stars {
    display: inline-flex;
    gap: 1px;
  }

  .reviews__card-stars .reviews__star { width: 16px; height: 16px; }

  .reviews__author-time {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
  }

  .reviews__text {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--color-ink);
  }

  /* "As featured on B93.7" press strip — media proof, links to the homepage film. */
  .reviews__press {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    max-width: 720px;
    margin: 0 auto 3.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--color-bone);
    border: 1px solid rgba(185, 145, 78, 0.4);
    border-radius: 8px;
    box-shadow: 0 30px 60px -45px rgba(26, 20, 16, 0.4);
  }

  .reviews__press-img {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-gold-soft);
  }

  .reviews__press-body .eyebrow { margin-bottom: 0.6rem; }

  .reviews__press-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--color-ink);
    margin-bottom: 0.85rem;
  }

  .reviews__press-text strong {
    font-style: normal;
    font-weight: 600;
    color: var(--color-maroon);
  }

  .reviews__press-text em { color: var(--color-maroon); }

  .reviews__press-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-maroon);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-maroon);
  }

  .reviews__press-arrow { transition: transform 0.3s var(--easing); }
  .reviews__press-link:hover .reviews__press-arrow { transform: translateX(4px); }

  .reviews__cta { text-align: center; }

  @media (max-width: 1024px) {
    .reviews__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .reviews__grid { grid-template-columns: 1fr; }

    .reviews__press {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }
    .reviews__press-body .eyebrow { justify-content: center; }
    .reviews__press-link { justify-content: center; }
  }
</style>
