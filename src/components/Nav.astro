---
import { NAV_LINKS, BUSINESS } from '../config/site';

// Mark the current page so the matching nav link can highlight.
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href.replace(/\/$/, '');
---

<header class="nav" id="site-nav">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Carolina Fine Foods — home">
      <img src="/images/logo.png" alt="Carolina Fine Foods" class="nav__brand-logo" width="450" height="266" />
      <span class="nav__brand-since">Est. 1983 · Simpsonville, SC</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class:list={[{ 'is-active': isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <a href={BUSINESS.orderUrl} target="_blank" rel="noopener" class="nav__cta">
      <span>Reserve · Order</span>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M3 8h10M9 4l4 4-4 4" />
      </svg>
    </a>

    <button class="nav__menu-btn" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-mobile">
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="nav__mobile" id="nav-mobile" aria-label="Mobile">
    {NAV_LINKS.map((link) => (
      <a href={link.href} class:list={[{ 'is-active': isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
    <a href={BUSINESS.orderUrl} target="_blank" rel="noopener" class="nav__mobile-cta">
      Reserve · Order
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M3 8h10M9 4l4 4-4 4" />
      </svg>
    </a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.25rem 0;
    transition: all 0.5s cubic-bezier(0.65, 0.05, 0.36, 1);
    background: linear-gradient(180deg, rgba(247, 242, 234, 0.7) 0%, rgba(247, 242, 234, 0) 100%);
    backdrop-filter: blur(0px);
  }

  .nav.is-scrolled {
    padding: 0.65rem 0;
    background: rgba(247, 242, 234, 0.92);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(26, 20, 16, 0.06);
  }

  .nav__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .nav__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    line-height: 1.1;
  }

  .nav__brand-logo {
    height: 46px;
    width: auto;
    transition: height 0.5s cubic-bezier(0.65, 0.05, 0.36, 1);
  }

  .nav.is-scrolled .nav__brand-logo {
    height: 38px;
  }

  .nav__brand-since {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-maroon);
    margin-top: 2px;
  }

  .nav__links {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
  }

  .nav__links a {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    position: relative;
    padding: 0.3rem 0;
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--color-maroon);
    transition: width 0.4s var(--easing);
  }

  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--color-maroon);
  }

  .nav__links a:hover::after,
  .nav__links a.is-active::after {
    width: 100%;
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bone);
    background: var(--color-maroon);
    border-radius: 999px;
    transition: all 0.35s var(--easing);
  }

  .nav__cta:hover {
    background: var(--color-maroon-deep);
    transform: translateY(-1px);
  }

  .nav__menu-btn {
    display: none;
    width: 36px;
    height: 36px;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
    align-items: center;
  }

  .nav__menu-btn span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-ink);
    transition: transform 0.3s var(--easing), opacity 0.3s var(--easing);
  }

  /* Hamburger → X when the menu is open */
  .nav.is-open .nav__menu-btn span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav.is-open .nav__menu-btn span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Slide-down mobile menu panel */
  .nav__mobile {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    padding: 0.5rem 2rem 1.5rem;
    background: rgba(247, 242, 234, 0.97);
    backdrop-filter: blur(14px);
    border-top: 1px solid rgba(185, 145, 78, 0.3);
    box-shadow: 0 24px 40px -24px rgba(26, 20, 16, 0.45);
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    transition: opacity 0.35s var(--easing), transform 0.35s var(--easing);
  }

  .nav.is-open .nav__mobile {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav__mobile a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    padding: 1rem 0;
    border-bottom: 1px solid rgba(26, 20, 16, 0.08);
  }

  .nav__mobile a:hover,
  .nav__mobile a.is-active { color: var(--color-maroon); }

  .nav__mobile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.9rem 1.25rem !important;
    color: var(--color-bone) !important;
    background: var(--color-maroon);
    border-radius: 999px;
    border-bottom: none !important;
    transition: background 0.35s var(--easing);
  }

  .nav__mobile-cta:hover { background: var(--color-maroon-deep); color: var(--color-bone) !important; }

  @media (max-width: 1024px) {
    .nav__links { display: none; }
    .nav__inner { grid-template-columns: 1fr auto auto; }
    .nav__menu-btn { display: flex; }
    .nav__mobile { display: flex; }
    /* Keep the bar opaque while the menu is open so links read clearly */
    .nav.is-open {
      background: rgba(247, 242, 234, 0.97);
      backdrop-filter: blur(14px);
    }
  }

  @media (max-width: 640px) {
    .nav__brand-since { display: none; }
    .nav__brand-logo { height: 38px; }
    .nav__cta span { display: none; }
    .nav__cta { width: 38px; height: 38px; padding: 0; justify-content: center; }
  }
</style>

<script is:inline>
  (function () {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const onScroll = () => {
      if (window.scrollY > 30) nav.classList.add('is-scrolled');
      else nav.classList.remove('is-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu toggle
    const toggle = document.getElementById('nav-toggle');
    const mobile = document.getElementById('nav-mobile');
    if (toggle && mobile) {
      const setOpen = (open) => {
        nav.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
      // Close after tapping any menu link
      mobile.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => setOpen(false))
      );
      // Close if resized up to desktop
      window.addEventListener('resize', () => {
        if (window.innerWidth > 1024) setOpen(false);
      });
    }
  })();
</script>
