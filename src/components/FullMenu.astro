      "Fried Okra",
      "Fried Green Tomatoes",
      "Onion Rings",
      "Loaded Fries",
      "Cheese Sticks",
    ],
  },
  {
    id: "salads",
    name: "Salads & Salad Bar",
    note: "Fresh greens and our full salad bar, Mon–Fri 11–3.",
    items: [
      "House Salad",
      "Chef Salad",
      "Garden Salad",
      "Chicken Tender Salad",
      "Cobb Salad",
      "Salad Bar (Mon–Fri)",
    ],
  },
  {
    id: "breakfast",
    name: "Breakfast",
    note: "Full breakfast buffet, Sat–Sun 7–11am.",
    items: [
