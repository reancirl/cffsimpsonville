---

<section
  class="fullmenu section"
  id="full-menu"
  aria-labelledby="full-menu-title"
>
  <div class="container">
    <header class="fullmenu__header">
      <span class="eyebrow" data-reveal>Every Dish</span>
      <h2 id="full-menu-title" data-reveal-heading>The Full Menu</h2>
      <p class="fullmenu__intro" data-reveal data-reveal-delay="0.15">
        Beyond the daily buffet, the kitchen turns out everything below — from
        sunrise breakfast to char-grilled steaks. Browse by the section that's
        calling your name.
      </p>
    </header>

    <div class="fullmenu__jump">
      <nav class="fullmenu__rail" aria-label="Menu categories">
        <ul class="fullmenu__tablist">
          {
            categories.map((cat, i) => (
              <li class="fullmenu__tab-item">
                <a
                  href={`#${cat.id}`}
                  class:list={["fullmenu__tab", { "is-active": i === 0 }]}
                  aria-current={i === 0 ? "true" : undefined}
                >
                  {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="fullmenu__list">
      {
        categories.map((cat) => (
          <article class="fullmenu__cat" id={cat.id} data-reveal>
            <div class="fullmenu__cat-head">
              <span class="fullmenu__cat-marker" aria-hidden="true">
                i
              </span>
              <div class="fullmenu__cat-heading">
                <h3 class="fullmenu__cat-name">{cat.name}</h3>
                <p class="fullmenu__cat-note">{cat.note}</p>
              </div>
            </div>
            <ul class="fullmenu__dishes">
              {cat.items.map((item) => (
                <li class="fullmenu__dish">{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fullmenu {
    background: var(--color-cream);
    border-top: 1px solid rgba(26, 20, 16, 0.1);
  }

  .fullmenu__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .fullmenu__header .eyebrow {
    margin-bottom: 1.25rem;
  }

  .fullmenu__header h2 {
    margin-bottom: 1.5rem;
  }

  .fullmenu__intro {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.6;
  }

  /* ── Sticky jump-nav: editorial underline tabs ────────────────────── */
  /* Small-caps category labels, gold-dot separators, gold underline on the
     active/hovered item — the same vocabulary as the underlined top nav. */
  .fullmenu__jump {
    position: sticky;
    /* Sit just below the fixed site header (its compact, scrolled height). */
    top: var(--header-height);
    z-index: 20;
    margin-bottom: 4rem;
    /* Faint cream surface + gold hairline so menu text can't bleed through. */
    padding: 0.85rem 0;
    background: rgba(239, 230, 214, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(185, 145, 78, 0.45);
  }

  /* Where the backdrop-filter blur isn't supported, fall back to a solid
     surface so menu text never shows through the bar. */
  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .fullmenu__jump {
      background: var(--color-cream);
    }
  }

  .fullmenu__rail {
    /* Horizontal scroller on narrow screens; centered + wrapping when wide. */
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: none; /* Firefox */
  }

  .fullmenu__rail::-webkit-scrollbar {
    display: none; /* WebKit/Blink */
  }

  .fullmenu__tablist {
    list-style: none;
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    padding: 0;
  }

  .fullmenu__tab-item {
    display: inline-flex;
    align-items: baseline;
  }

  /* Gold dot between items (decorative — not the last one). */
  .fullmenu__tab-item:not(:last-child)::after {
    content: "·";
    margin-left: 1.1rem;
    color: var(--color-gold);
    font-size: 0.9rem;
    line-height: 1;
    pointer-events: none;
  }

  .fullmenu__tab {
    position: relative;
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink-soft);
    padding: 0.35rem 0.1rem;
    transition: color 0.3s var(--easing);
  }

  /* Thin gold underline that grows in from the left on hover/active. */
  .fullmenu__tab::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1.5px;
    background: var(--color-gold);
    transition: width 0.4s var(--easing);
  }

  .fullmenu__tab:hover {
    color: var(--color-maroon);
  }

  .fullmenu__tab:hover::after,
  .fullmenu__tab.is-active::after {
    width: 100%;
  }

  /* Active/current category: maroon text + full gold underline. */
  .fullmenu__tab.is-active {
    color: var(--color-maroon);
  }

  /* Clear, visible keyboard focus. */
  .fullmenu__tab:focus-visible {
    outline: 2px solid var(--color-maroon);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Narrow screens: single line, horizontal scroll, momentum, left-aligned. */
  @media (max-width: 768px) {
    .fullmenu__jump {
      /* Let the scroller bleed to the container edges so items can scroll
         fully into/out of view rather than being clipped by side padding. */
      margin-left: -1.25rem;
      margin-right: -1.25rem;
      /* Opaque surface on mobile — blur is GPU-throttled here, so a
         translucent bar lets the heading behind it ghost through. A solid
         cream keeps the menu text from bleeding into the rail. */
      background: var(--color-cream);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      /* Hold a faint top hairline too so the bar reads as a distinct band
         once the heading scrolls up beneath it. */
      border-top: 1px solid rgba(185, 145, 78, 0.45);
    }

    .fullmenu__tablist {
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 0;
      padding: 0 1.25rem;
    }
  }

  /* Respect reduced-motion: no growing underline, instant on/off instead. */
  @media (prefers-reduced-motion: reduce) {
    .fullmenu__tab,
    .fullmenu__tab::after {
      transition: none;
    }
  }

  /* ── Category lists ───────────────────────────────────────────────── */
  .fullmenu__list {
    max-width: 900px;
    margin: 0 auto;
  }

  .fullmenu__cat {
    padding: 3rem 0;
    border-top: 1px solid rgba(26, 20, 16, 0.12);
    /* Offset anchor jumps so headings clear the fixed site header + sticky rail
       (header height + the rail's own ~3.5rem). */
    scroll-margin-top: calc(var(--header-height) + 3.5rem);
  }

  .fullmenu__cat:first-child {
    border-top: none;
    padding-top: 0;
  }

  .fullmenu__cat-head {
    display: flex;
    align-items: stretch;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  /* Decorative italic index glyph with a vertical maroon divider rule that
     spans the full header height, echoing the curated highlights' markers. */
  .fullmenu__cat-marker {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    padding-right: 1.5rem;
    border-right: 1px solid var(--color-maroon);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1;
    color: var(--color-gold);
  }

  .fullmenu__cat-heading {
    min-width: 0;
  }

  .fullmenu__cat-name {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 0.5rem;
  }

  .fullmenu__cat-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .fullmenu__dishes {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem 2.5rem;
  }

  .fullmenu__dish {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.4;
    padding-bottom: 0.75rem;
    border-bottom: 1px dotted rgba(26, 20, 16, 0.18);
  }

  @media (max-width: 768px) {
    .fullmenu__dishes {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .fullmenu__dishes {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  // Scroll-spy for the editorial underline-tab rail: as each category section
  // scrolls past, mark its tab active (gold underline + maroon text +
  // aria-current) and slide it into view inside the horizontally-scrolling rail
  // so it's never off-screen on mobile.
  (function () {
    const rail = document.querySelector(".fullmenu__rail");
    const tabs = Array.from(document.querySelectorAll(".fullmenu__tab"));
    if (!tabs.length) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Map each section id → its tab.
    const byId = new Map();
    tabs.forEach((a) => {
      const id = a.getAttribute("href").slice(1);
      byId.set(id, a);
    });

    // Keep the active tab centered within the rail without moving the page.
    function revealInRail(tab) {
      if (!rail) return;
      const railRect = rail.getBoundingClientRect();
      const tabRect = tab.getBoundingClientRect();
      const offset =
        tabRect.left -
        railRect.left -
        (railRect.width - tabRect.width) / 2 +
        rail.scrollLeft;
      rail.scrollTo({
        left: offset,
        behavior: reduceMotion ? "auto" : "smooth",
      });
    }

    function setActive(id) {
      const next = byId.get(id);
      if (!next || next.classList.contains("is-active")) return;
      tabs.forEach((a) => {
        a.classList.remove("is-active");
        a.removeAttribute("aria-current");
      });
      next.classList.add("is-active");
      next.setAttribute("aria-current", "true");
      revealInRail(next);
    }

    // Reduced-motion: native CSS smooth-scroll is globally on; fall back to an
    // instant jump for the anchor click so opted-out users get no animation.
    if (reduceMotion) {
      tabs.forEach((a) =>
        a.addEventListener("click", (e) => {
          const target = document.getElementById(
            a.getAttribute("href").slice(1),
          );
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: "auto" });
          setActive(target.id);
        }),
      );
    }

    let activeId = null;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target.id !== activeId) {
            activeId = entry.target.id;
            setActive(activeId);
          }
        });
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );

    document
      .querySelectorAll(".fullmenu__cat")
      .forEach((cat) => observer.observe(cat));
  })();
</script>
