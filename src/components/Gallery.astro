---
import { YEARS_WORD } from '../config/years';

interface Props {
  variant?: 'full' | 'teaser';
  headingLevel?: 'h1' | 'h2';
}
const { variant = 'full', headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const isTeaser = variant === 'teaser';

const images = [
  { src: '/images/honest.webp', alt: 'Honest. Wholesome. Quality.', caption: 'Honest. Wholesome. Quality.', span: 'tall' },
  { src: '/images/dish-1.webp', alt: 'Southern plated dish', caption: 'Made by hand, every morning', span: 'normal' },
  { src: '/images/fresh-hot.webp', alt: 'Fresh hot served buffet', caption: 'Fresh & hot — straight to the table', span: 'normal' },
  { src: '/images/dish-3.webp', alt: 'Carolina Fine Foods signature plate', caption: "Grandma's recipe, kept exactly", span: 'wide' },
  { src: '/images/zinger.webp', alt: 'Zinger fried chicken', caption: 'Crisp, golden, never frozen', span: 'normal' },
  { src: '/images/buffet.webp', alt: 'The Carolina Fine Foods buffet line', caption: 'Two hundred dishes on the line', span: 'normal' },
  { src: '/images/grilled-chicken.webp', alt: 'A heaping Southern platter with all the fixings', caption: 'Piled high, with all the sides', span: 'normal' },
  { src: '/images/banner.webp', alt: 'Carolina Fine Foods banner', caption: 'A table set for everyone', span: 'normal' },
];
---

<section class="gallery section" id="gallery">
  <div class="container">
    <header class="gallery__header">
      <div>
        <span class="eyebrow" data-reveal>The Spread</span>
        <Heading data-reveal-heading>A glimpse from our kitchen.</Heading>
      </div>
      <p data-reveal data-reveal-delay="0.15">
        Walk through the door, and you'll smell biscuits before you see the buffet. Here&rsquo;s a quiet look at what waits inside &mdash; the dishes, the porch, the warmth of {YEARS_WORD} years.
      </p>
    </header>

    <div class="gallery__grid" data-reveal-stagger>
      {(isTeaser ? images.slice(0, 5) : images).map((img, idx) => (
        <figure class={`gallery__item gallery__item--${img.span}`}>
          <button type="button" class="gallery__trigger" data-index={idx} aria-label={`View larger: ${img.caption}`}>
            <span class="gallery__image-wrap">
              <img src={img.src} alt={img.alt} loading="lazy" />
              <span class="gallery__overlay">
                <span class="gallery__caption">{img.caption}</span>
              </span>
              <span class="gallery__zoom" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35M11 8v6M8 11h6" />
                </svg>
              </span>
            </span>
          </button>
        </figure>
      ))}
    </div>

    {isTeaser ? (
      <div class="gallery__cta" data-reveal>
        <a href="/gallery" class="btn btn-primary">
          View the full gallery
          <span class="btn-arrow">→</span>
        </a>
      </div>
    ) : (
      <>
        <div class="gallery__quote" data-reveal>
          <svg class="gallery__quote-mark" width="48" height="36" viewBox="0 0 48 36" fill="currentColor">
            <path d="M0 36V20Q0 12 4 6T16 0v8q-4 0-6 3t-2 7h8v18zm24 0V20q0-8 4-14T40 0v8q-4 0-6 3t-2 7h8v18z"/>
          </svg>
          <blockquote>
            Recipes that we have, have been passed down to us by you. We just try our best to keep them honest.
          </blockquote>
          <cite>— The Carolina Family · Simpsonville, SC</cite>
        </div>

        <div class="gallery__end-cta" data-reveal>
          <p class="gallery__end-text">Hungry yet?</p>
          <div class="gallery__end-buttons">
            <a href="/menu" class="btn btn-primary">
              See the menu
              <span class="btn-arrow">→</span>
            </a>
            <a href="/visit" class="btn btn-ghost">Plan your visit</a>
          </div>
        </div>
      </>
    )}
  </div>

  <!-- Lightbox: click any photo to view it large, arrows / swipe to move. -->
  <div class="gallery__lightbox" id="gallery-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <button type="button" class="gallery__lb-close" aria-label="Close viewer">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <button type="button" class="gallery__lb-nav gallery__lb-prev" aria-label="Previous photo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <figure class="gallery__lb-figure">
      <img class="gallery__lb-img" src="" alt="" />
      <figcaption class="gallery__lb-caption"></figcaption>
    </figure>
    <button type="button" class="gallery__lb-nav gallery__lb-next" aria-label="Next photo">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5l7 7-7 7"/></svg>
    </button>
    <span class="gallery__lb-count" aria-hidden="true"></span>
  </div>
</section>

<style>
  .gallery {
    background: var(--color-cream);
    position: relative;
  }

  .gallery__header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: end;
    margin-bottom: 4rem;
  }

  .gallery__header .eyebrow { margin-bottom: 1rem; }

  .gallery__header h2 { max-width: 14ch; }

  .gallery__header p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px;
    grid-auto-flow: dense;
    gap: 1.25rem;
    margin-bottom: 5rem;
  }

  .gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 20px 40px -25px rgba(26, 20, 16, 0.45);
    transition: transform 0.6s var(--easing), box-shadow 0.6s var(--easing);
  }

  .gallery__item--tall { grid-column: span 1; grid-row: span 2; }
  .gallery__item--wide { grid-column: span 2; grid-row: span 2; }
  .gallery__item--normal { grid-column: span 1; grid-row: span 1; }

  .gallery__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 40px 60px -30px rgba(26, 20, 16, 0.55);
  }

  /* Each photo is a button that opens the lightbox. */
  .gallery__trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gallery__trigger:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  /* Keyboard focus mirrors the hover reveal. */
  .gallery__item:focus-within img { transform: scale(1.08); filter: saturate(1.15); }
  .gallery__item:focus-within .gallery__overlay { opacity: 1; }
  .gallery__item:focus-within .gallery__caption { transform: translateY(0); }
  .gallery__item:focus-within .gallery__zoom,
  .gallery__item:hover .gallery__zoom { opacity: 1; transform: translateY(0); }

  .gallery__zoom {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    color: var(--color-bone);
    background: rgba(26, 20, 16, 0.45);
    border: 1px solid rgba(247, 242, 234, 0.35);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.4s var(--easing), transform 0.4s var(--easing);
    pointer-events: none;
  }

  .gallery__image-wrap {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .gallery__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s var(--easing), filter 1s var(--easing);
    filter: saturate(1.05);
  }

  .gallery__item:hover img {
    transform: scale(1.08);
    filter: saturate(1.15);
  }

  .gallery__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(26, 20, 16, 0.7) 100%);
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.5s var(--easing);
  }

  .gallery__item:hover .gallery__overlay { opacity: 1; }

  .gallery__caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-bone);
    transform: translateY(10px);
    transition: transform 0.5s var(--easing);
  }

  .gallery__item:hover .gallery__caption {
    transform: translateY(0);
  }

  .gallery__cta {
    text-align: center;
    padding: 1rem 0 2rem;
  }

  .gallery__quote {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    padding: 4rem 0 2rem;
    color: var(--color-gold);
    position: relative;
  }

  .gallery__quote-mark {
    color: var(--color-gold);
    opacity: 0.55;
    margin-bottom: 1.5rem;
  }

  .gallery__quote blockquote {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.35;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }

  .gallery__quote cite {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-maroon);
  }

  /* Closing call-to-action after the quote. */
  .gallery__end-cta {
    text-align: center;
    border-top: 1px solid rgba(26, 20, 16, 0.12);
    max-width: 760px;
    margin: 3.5rem auto 0;
    padding-top: 3.5rem;
  }

  .gallery__end-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    color: var(--color-ink);
    margin-bottom: 1.75rem;
  }

  .gallery__end-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Lightbox ─────────────────────────────────────────────────────── */
  .gallery__lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(26, 20, 16, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .gallery__lightbox[hidden] { display: none; }

  .gallery__lb-figure {
    margin: 0;
    max-width: min(1100px, 100%);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .gallery__lb-img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 2px;
    background: #000;
    box-shadow: var(--shadow-deep), 0 0 0 1px rgba(185, 145, 78, 0.35);
  }

  .gallery__lb-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-bone);
    text-align: center;
    max-width: 60ch;
  }

  .gallery__lb-count {
    position: absolute;
    bottom: clamp(1rem, 3vw, 1.75rem);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(247, 242, 234, 0.6);
  }

  .gallery__lb-close,
  .gallery__lb-nav {
    position: absolute;
    display: grid;
    place-items: center;
    color: var(--color-bone);
    background: rgba(26, 20, 16, 0.35);
    border: 1px solid rgba(247, 242, 234, 0.3);
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.3s var(--easing), border-color 0.3s var(--easing),
      transform 0.3s var(--easing);
  }

  .gallery__lb-close:hover,
  .gallery__lb-nav:hover {
    background: var(--color-maroon);
    border-color: var(--color-maroon);
  }

  .gallery__lb-close:focus-visible,
  .gallery__lb-nav:focus-visible {
    outline: 2px solid var(--color-gold-soft);
    outline-offset: 2px;
  }

  .gallery__lb-close {
    top: clamp(1rem, 3vw, 1.75rem);
    right: clamp(1rem, 3vw, 1.75rem);
    width: 44px;
    height: 44px;
  }

  .gallery__lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
  }

  .gallery__lb-nav:hover { transform: translateY(-50%) scale(1.06); }

  .gallery__lb-prev { left: clamp(0.5rem, 3vw, 2rem); }
  .gallery__lb-next { right: clamp(0.5rem, 3vw, 2rem); }

  /* Lock the page behind the open lightbox. */
  :global(body.gallery-lb-open) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .gallery__lb-close,
    .gallery__lb-nav,
    .gallery__zoom { transition: none; }
    .gallery__lb-nav:hover { transform: translateY(-50%); }
  }

  @media (max-width: 560px) {
    .gallery__lb-nav { width: 42px; height: 42px; }
    .gallery__lb-prev { left: 0.5rem; }
    .gallery__lb-next { right: 0.5rem; }
    .gallery__lb-caption { font-size: 1rem; }
  }

  @media (max-width: 1024px) {
    .gallery__header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
    .gallery__item--wide { grid-column: span 2; grid-row: span 1; grid-row-end: auto; }
    .gallery__item--tall { grid-column: span 1; grid-row: span 2; }
  }

  @media (max-width: 560px) {
    .gallery__grid { grid-auto-rows: 150px; gap: 0.75rem; }
  }
</style>

<script is:inline>
  // Accessible image lightbox: click/Enter a photo to open; ← → / swipe to move;
  // Esc, the close button, or a backdrop click to dismiss. Focus is trapped
  // while open and restored to the photo you opened from.
  (function () {
    const lb = document.getElementById('gallery-lightbox');
    const triggers = Array.from(document.querySelectorAll('.gallery__trigger'));
    if (!lb || !triggers.length) return;

    const lbImg = lb.querySelector('.gallery__lb-img');
    const lbCap = lb.querySelector('.gallery__lb-caption');
    const lbCount = lb.querySelector('.gallery__lb-count');
    const btnClose = lb.querySelector('.gallery__lb-close');
    const btnPrev = lb.querySelector('.gallery__lb-prev');
    const btnNext = lb.querySelector('.gallery__lb-next');
    const focusables = [btnClose, btnPrev, btnNext];

    // Build slide data from the DOM so it always matches what's rendered.
    const slides = triggers.map(function (t) {
      const img = t.querySelector('img');
      const cap = t.querySelector('.gallery__caption');
      return {
        src: img.getAttribute('src'),
        alt: img.getAttribute('alt') || '',
        caption: cap ? cap.textContent : '',
      };
    });

    let current = 0;
    let lastFocus = null;

    function render() {
      const s = slides[current];
      lbImg.setAttribute('src', s.src);
      lbImg.setAttribute('alt', s.alt);
      lbCap.textContent = s.caption;
      lbCount.textContent = current + 1 + ' / ' + slides.length;
    }

    function open(i) {
      current = i;
      render();
      lb.hidden = false;
      document.body.classList.add('gallery-lb-open');
      lastFocus = document.activeElement;
      btnClose.focus();
    }

    function close() {
      lb.hidden = true;
      document.body.classList.remove('gallery-lb-open');
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function go(delta) {
      current = (current + delta + slides.length) % slides.length;
      render();
    }

    triggers.forEach(function (t, i) {
      t.addEventListener('click', function () { open(i); });
    });
    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', function () { go(-1); });
    btnNext.addEventListener('click', function () { go(1); });

    // Click on the dark backdrop (not the image/controls) closes.
    lb.addEventListener('click', function (e) {
      if (e.target === lb) close();
    });

    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') { close(); }
      else if (e.key === 'ArrowLeft') { go(-1); }
      else if (e.key === 'ArrowRight') { go(1); }
      else if (e.key === 'Tab') {
        // Trap focus among the dialog's controls.
        const i = focusables.indexOf(document.activeElement);
        if (e.shiftKey) {
          if (i <= 0) { e.preventDefault(); focusables[focusables.length - 1].focus(); }
        } else if (i === -1 || i === focusables.length - 1) {
          e.preventDefault();
          focusables[0].focus();
        }
      }
    });

    // Swipe to navigate on touch devices.
    let touchX = null;
    lb.addEventListener('touchstart', function (e) { touchX = e.changedTouches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', function (e) {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
      touchX = null;
    }, { passive: true });
  })();
</script>
