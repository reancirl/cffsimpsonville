<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <div class="footer__mark">CFF</div>
      <h3 class="footer__name">Carolina Fine Foods</h3>
      <p class="footer__tag">The most authentic Southern cuisine, family-owned since 1983.</p>
    </div>

    <div class="footer__col">
      <h4>Visit</h4>
      <address>
        625 SE Main St<br />
        Simpsonville, SC 29681
      </address>
      <a href="https://maps.google.com/?q=625+SE+Main+St+Simpsonville+SC+29681" target="_blank" rel="noopener" class="footer__link">Get directions →</a>
    </div>

    <div class="footer__col">
      <h4>Hours</h4>
      <ul>
        <li><span>Lunch Buffet</span><em>Mon – Fri · 11:00am – 2:30pm</em></li>
        <li><span>Breakfast Buffet</span><em>Sat – Sun · 7:00am – 11:00am</em></li>
        <li><span>Salad Bar</span><em>Mon – Fri · 11:00am – 3:00pm</em></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4>Contact</h4>
      <a href="tel:+18649673335" class="footer__phone">+1 864-967-3335</a>
      <a href="mailto:cffsimpsonville@gmail.com">cffsimpsonville@gmail.com</a>
      <div class="footer__social">
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.892h-2.33v6.987C18.343 21.128 22 16.991 22 12z"/></svg>
        </a>
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {new Date().getFullYear()} Carolina Fine Foods. All rights reserved.</p>
      <p class="footer__credit">Crafted with care · Simpsonville, South Carolina</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-cream);
    padding: 6rem 0 0;
    position: relative;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: 4rem;
    padding-bottom: 5rem;
  }

  .footer__brand {
    max-width: 320px;
  }

  .footer__mark {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-maroon);
    color: var(--color-bone);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    border: 1px solid var(--color-gold);
    box-shadow: inset 0 0 0 4px var(--color-maroon);
    margin-bottom: 1.5rem;
  }

  .footer__name {
    color: var(--color-bone);
    font-size: 1.6rem;
    margin-bottom: 0.75rem;
  }

  .footer__tag {
    font-size: 0.95rem;
    color: rgba(247, 242, 234, 0.65);
    line-height: 1.7;
  }

  .footer__col h4 {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1.5rem;
  }

  .footer__col address,
  .footer__col a,
  .footer__col ul {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.95rem;
    color: rgba(247, 242, 234, 0.78);
    list-style: none;
    line-height: 1.85;
    display: block;
  }

  .footer__col ul li {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.85rem;
  }

  .footer__col ul li span {
    color: var(--color-bone);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .footer__col ul li em {
    font-style: normal;
    color: rgba(247, 242, 234, 0.55);
    font-size: 0.85rem;
  }

  .footer__col a:hover {
    color: var(--color-gold-soft);
  }

  .footer__link {
    color: var(--color-gold-soft) !important;
    margin-top: 0.75rem;
    font-size: 0.85rem !important;
    letter-spacing: 0.05em;
  }

  .footer__phone {
    font-family: var(--font-display) !important;
    font-size: 1.4rem !important;
    color: var(--color-bone) !important;
    display: inline-block !important;
    margin-bottom: 0.5rem !important;
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .footer__social a {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(247, 242, 234, 0.2);
    border-radius: 50%;
    display: grid !important;
    place-items: center;
    color: rgba(247, 242, 234, 0.7);
    transition: all 0.3s var(--easing);
  }

  .footer__social a:hover {
    background: var(--color-maroon);
    border-color: var(--color-maroon);
    color: var(--color-bone) !important;
    transform: translateY(-2px);
  }

  .footer__bottom {
    border-top: 1px solid rgba(247, 242, 234, 0.08);
    padding: 1.75rem 0;
  }

  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer__bottom p {
    font-size: 0.78rem;
    color: rgba(247, 242, 234, 0.4);
    letter-spacing: 0.05em;
  }

  .footer__credit {
    font-style: italic;
    font-family: var(--font-serif);
    color: rgba(247, 242, 234, 0.55) !important;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
