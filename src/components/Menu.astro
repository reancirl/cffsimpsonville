---
interface Props {
  /** "full" shows everything; "teaser" trims to a preview with a link out. */
  variant?: 'full' | 'teaser';
  /** Heading tag for the section title — h1 on the dedicated page, h2 elsewhere. */
  headingLevel?: 'h1' | 'h2';
  /** Hide the closing note + CTAs (e.g. when the full-menu page closes them itself). */
  showFooter?: boolean;
}
const { variant = 'full', headingLevel = 'h2', showFooter = true } = Astro.props;
const isTeaser = variant === 'teaser';

const categories = [
  {
    name: 'From the Kitchen',
    note: 'Slow-cooked, hand-prepared, made fresh every morning',
    items: [
      { name: 'Hamburger Steak', desc: 'Hand-pattied, smothered in onions & brown gravy', tag: 'Signature' },
      { name: 'Chicken with Rice & Gravy', desc: 'Tender, fall-apart chicken over Carolina rice', tag: '' },
      { name: 'Country Chicken Livers', desc: 'Crisp-fried, served with peppered cream gravy', tag: '' },
      { name: 'Minced BBQ', desc: 'Slow-pulled pork, the family vinegar sauce', tag: 'Local Favorite' },
    ],
  },
  {
    name: 'Buffet & Garden',
    note: 'Two hundred dishes daily — and a salad bar to start',
    items: [
      { name: 'Garden Salad Bar', desc: 'Crisp greens, garden vegetables, house dressings', tag: 'Mon–Fri 11–3' },
      { name: 'Mac & Cheese', desc: 'Baked golden and creamy — the side regulars drive across town for.', tag: 'Popular' },
      { name: 'Garden Vegetables', desc: 'Collards, butter beans, and fried okra.', tag: '' },
      { name: 'Catch of the Day', desc: 'Friday seafood night — flounder, shrimp, hush puppies', tag: 'Fridays' },
      { name: 'Steakhouse Cuts', desc: 'Ribeye, sirloin, served the proper way', tag: '' },
    ],
  },
  {
    name: 'Sweet Endings',
    note: "Grandma's after-supper tradition",
    items: [
      { name: 'Banana Pudding', desc: 'Layered the old way — wafers, custard, soft cream', tag: 'House Classic' },
      { name: 'Peach Cobbler', desc: 'Carolina peaches under a buttery, sugared crust', tag: '' },
      { name: 'Pecan Pie', desc: 'Deep, dark, and just sweet enough', tag: '' },
      { name: 'Sweet Tea', desc: 'Brewed fresh, the way Mama taught us', tag: '' },
    ],
  },
];
---

<section class="menu section" id="menu">
  <div class="menu__bg" data-parallax="0.4"></div>

  <div class="container">
    <header class="menu__header">
      <span class="eyebrow" data-reveal>The Table</span>
      {headingLevel === 'h1' ? (
        <>
          <h1 class="menu__page-title" data-reveal-heading>Our Menu</h1>
          <p class="menu__headline" data-reveal data-reveal-delay="0.1">Two hundred dishes. One promise.</p>
        </>
      ) : (
        <h2 data-reveal-heading>Two hundred dishes. One promise.</h2>
      )}
      <p data-reveal data-reveal-delay="0.15">
        From sunrise breakfast to the last spoon of banana pudding, every plate is a taste of the South — made by hand with cast iron, patience, and the recipes our grandmothers swore by.
      </p>
    </header>

    {/* Optional feature photo, slotted in right after the intro (menu page only). */}
    <slot name="feature" />

    <div class="menu__categories">
      {categories.map((cat, idx) => (
        <div class="menu__category" data-reveal>
          <div class="menu__category-head">
            <span class="menu__category-num">{String(idx + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="menu__category-name">{cat.name}</h3>
              <p class="menu__category-note">{cat.note}</p>
            </div>
          </div>

          <ul class="menu__items">
            {(isTeaser ? cat.items.slice(0, 2) : cat.items).map((item) => (
              <li class="menu__item">
                <div class="menu__item-row">
                  <h4 class="menu__item-name">{item.name}</h4>
                  {item.tag && <span class="menu__item-tag">{item.tag}</span>}
                  <span class="menu__item-dots" aria-hidden="true"></span>
                </div>
                <p class="menu__item-desc">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {showFooter && (
    <div class="menu__footer" data-reveal>
      <p class="menu__footer-text">
        {isTeaser
          ? 'This is just a taste — two hundred Southern dishes wait on the full menu.'
          : "The full menu changes with the day — ask your server about today's specials."}
      </p>
      <div class="menu__footer-actions">
        {isTeaser ? (
          <a href="/menu" class="btn btn-primary">
            See the full menu
            <span class="btn-arrow">→</span>
          </a>
        ) : (
          <a href="tel:+18649673335" class="btn btn-primary">
            Call to order
            <span class="btn-arrow">→</span>
          </a>
        )}
        <a href="https://maps.google.com/?q=625+SE+Main+St+Simpsonville+SC+29681" target="_blank" rel="noopener" class="btn btn-ghost">
          Dine with us
        </a>
      </div>
    </div>
    )}
  </div>
</section>

<style>
  .menu {
    background: linear-gradient(180deg, var(--color-bone) 0%, var(--color-cream) 100%);
    position: relative;
    overflow: hidden;
  }

  .menu__bg {
    position: absolute;
    inset: -10% -5%;
    background-image: url('/images/dish-2.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.04;
    filter: sepia(0.5);
    pointer-events: none;
  }

  .menu__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 5rem;
  }

  .menu__header .eyebrow {
    margin-bottom: 1.25rem;
  }

  .menu__header h2 {
    margin-bottom: 1.5rem;
  }

  .menu__page-title {
    margin-bottom: 1rem;
  }

  /* The curated headline sits as an italic serif sub-line beneath the H1 */
  .menu__headline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    color: var(--color-maroon);
    margin-bottom: 1.5rem;
  }

  .menu__header p {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.6;
  }

  .menu__categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem;
    margin-bottom: 5rem;
    position: relative;
  }

  .menu__category {
    background: var(--color-bone);
    padding: 2.5rem 2rem;
    border: 1px solid rgba(185, 145, 78, 0.2);
    border-radius: 2px;
    box-shadow: 0 30px 60px -40px rgba(26, 20, 16, 0.25);
    position: relative;
    transition: transform 0.5s var(--easing), box-shadow 0.5s var(--easing);
  }

  .menu__category::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1.5rem;
    right: 1.5rem;
    height: 2px;
    background: var(--color-maroon);
  }

  .menu__category:hover {
    transform: translateY(-6px);
    box-shadow: 0 50px 80px -40px rgba(26, 20, 16, 0.35);
  }

  .menu__category-head {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(26, 20, 16, 0.08);
  }

  .menu__category-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-gold);
    line-height: 1;
    margin-top: 0.25rem;
  }

  .menu__category-name {
    font-size: 1.6rem;
    margin-bottom: 0.25rem;
  }

  .menu__category-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .menu__items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .menu__item-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .menu__item-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-ink);
    flex: 0 1 auto;
    min-width: 0;
  }

  .menu__item-tag {
    flex: 0 0 auto;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-maroon);
    background: rgba(107, 29, 42, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  /* Trailing rule grows to fill the row, so every right edge is flush */
  .menu__item-dots {
    flex: 1 1 auto;
    min-width: 0;
    border-bottom: 1px dotted rgba(26, 20, 16, 0.25);
  }

  .menu__item-desc {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.93rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    margin-top: 0.35rem;
  }

  .menu__footer {
    text-align: center;
    border-top: 1px solid rgba(26, 20, 16, 0.12);
    padding-top: 3.5rem;
  }

  .menu__footer-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-ink);
    margin-bottom: 2rem;
  }

  .menu__footer-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .menu__categories {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 380px) {
    /* Let title/tag wrap on the narrowest screens; the rule still fills the row */
    .menu__item-row { flex-wrap: wrap; }
  }
</style>
